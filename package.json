{
  "name": "webgazer",
  "version": "3.3.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/brownhci/WebGazer.git"
  },
  "license": "GPL-3.0-or-later",
  "main": "dist/webgazer.cjs.js",
  "module": "dist/webgazer.es.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "dev:main": "vite build --watch --mode development",
    "dev:worker": "vite build --config vite.worker.config.js --watch --mode development",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:worker\"",
    "demo": "npm run dev --prefix demo",
    "typecheck": "tsc --noEmit",
    "typecheck:src": "tsc",
    "build": "npm run typecheck:src && vite build --config vite.worker.config.js && vite build",
    "gen_docs": "jsdoc -c jsdoc.conf.json src/*",
    "lint": "eslint . --ext .ts,.js,.cjs",
    "lint:fix": "eslint . --ext .ts,.js,.cjs --fix"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/webgazer.es.js",
      "require": "./dist/webgazer.cjs.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "keywords": [
    "webgazer",
    "eyetracking",
    "webcam",
    "online"
  ],
  "dependencies": {
    "@tensorflow-models/face-landmarks-detection": "0.0.3",
    "@tensorflow/tfjs": "^3.15.0",
    "localforage": "1.7.3",
    "regression": "2.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "jsdoc": "^4.0.2",
    "rimraf": "2.6.3",
    "typescript": "^5.0.0",
    "vite": "^5.4.3",
    "vite-plugin-banner": "^0.8.0"
  }
}
